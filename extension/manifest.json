{
  "manifest_version": 3,
  "name": "synclEE",
  "version": "1.0.1",
  "description": "Save accepted coding submissions to a GitHub repository you choose.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://www.codechef.com/*", "https://www.hackerrank.com/*", "https://www.geeksforgeeks.org/*", "https://practice.geeksforgeeks.org/*"],
      "js": ["editor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/*", "https://www.codechef.com/*", "https://www.hackerrank.com/*", "https://www.geeksforgeeks.org/*", "https://practice.geeksforgeeks.org/*"],
      "js": ["capture.js"],
      "run_at": "document_start"
    }
  ]
}
